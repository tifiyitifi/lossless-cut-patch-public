{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@mifi/lint-config/oxlintrc.json"
  ],
  "ignorePatterns": [
    ".yarn",
    "dist",
    "out",
    "main-ts-dist",
    "preload-ts-dist",
    "common-ts-dist",
    "website/dist",
    "website/.wrangler",
    "website/.astro",
    "**/*.astro",
    "src/renderer/src/features/patchLegacy",
    "ai-tmp"
  ],
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "@stylistic/function-call-spacing": "off",
    // Express 5 forwards rejected promises to the error handler
    "oxc/no-async-endpoint-handlers": "off",
    // TODO stage 2 rules from @mifi/lint-config with many findings here (count in parentheses), turned off until fixed
    "unicorn-js/consistent-boolean-name": "off", // (95)
    "react/exhaustive-effect-dependencies": "off", // (81)
    "typescript/promise-function-async": "off", // (50)
    "react/only-export-components": "off", // (48)
    "unicorn/consistent-function-scoping": "off", // (23)
    "promise/prefer-await-to-then": "off", // (13)
    "jsx-a11y/prefer-tag-over-role": "off", // (60)
    "react/hooks": "off", // (32)
    "react/memo-dependencies": "off", // (20)
    "unicorn/prefer-number-coercion": "off", // (95)
    "unicorn-js/prefer-simple-condition-first": "off", // (17)
    "unicorn-js/prefer-early-return": "off", // (26)
    "unicorn/max-nested-calls": "off", // (22)
    "unicorn-js/no-declarations-before-early-exit": "off", // (15)
    "unicorn-js/no-top-level-assignment-in-function": "off", // (25)
    "unicorn-js/no-unnecessary-array-flat-map": "off", // (20)
    "unicorn-js/prefer-await": "off", // (14)
    "unicorn-js/no-computed-property-existence-check": "off", // (15)
    "typescript/prefer-nullish-coalescing": "off", // (33)
    "typescript/strict-boolean-expressions": "off", // (275)
    "typescript/no-unsafe-assignment": "off", // (69)
    "typescript/no-confusing-void-expression": "off", // (396)
    "typescript/no-unnecessary-condition": "off", // (97)
    "typescript/no-unsafe-member-access": "off", // (54)
    "typescript/no-unsafe-return": "off", // (11)
    "typescript/restrict-template-expressions": "off", // (18)
    "typescript/no-unsafe-argument": "off", // (33)
    "typescript/unbound-method": "off", // (8)
    "typescript/no-duplicate-type-constituents": "off", // (11)
    "typescript/no-floating-promises": "off", // (116)
    "typescript/no-unnecessary-type-conversion": "off", // (9)
    "typescript/no-redundant-type-constituents": "off", // (8)
    "typescript/require-await": "off", // (19)
    "typescript/no-misused-promises": "off", // (121)
    "@eslint-react/use-state": "off", // (87)
    "@eslint-react/no-forward-ref": "off", // (7)
    "vitest/prefer-snapshot-hint": "off", // (11)
    "oxc/no-map-spread": "off", // (8)
    // TODO remove the type assertions (58), then use the shared config's assertionStyle: never
    "@typescript-eslint/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "as"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/renderer/**"
      ],
      "env": {
        "node": false,
        "browser": true
      },
      "rules": {
        "no-console": "off",
        "import-js/no-extraneous-dependencies": "off",
        "unicorn/prefer-global-this": "off",
        "import/extensions": "off"
      }
    },
    {
      "files": [
        "src/preload/**"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "no-console": "off",
        "import-js/no-extraneous-dependencies": "off",
        "unicorn/prefer-global-this": "off"
      }
    },
    {
      "files": [
        "script/**",
        "website/**",
        "electron.vite.config.ts",
        "vitest.config.ts"
      ],
      "rules": {
        "import-js/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": true,
            "optionalDependencies": false
          }
        ],
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/renderer/src/util/rate-calculator.ts",
        "src/renderer/src/util/rate-calculator.test.ts",
        "src/main/pathToFileURL.test.ts"
      ],
      "rules": {
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": [
        "src/renderer/src/App.tsx"
      ],
      "rules": {
        "react-hooks/refs": "off",
        "react-hooks/immutability": "off",
        "react-hooks/preserve-manual-memoization": "off"
      }
    },
    {
      // Fork feature slices (src/{common,main,renderer/src}/features/**): upstream's new
      // @mifi/lint-config rules mostly ask for refactors of logic this fork wrote and tested.
      // Keep that code untouched while merging upstream, and pay these down in a separate pass
      // instead of rewriting it during a merge. Upstream-owned files keep the full rule set.
      "files": [
        "src/common/features/**",
        "src/main/features/**",
        "src/renderer/src/features/**"
      ],
      "rules": {
        "@eslint-react/no-context-provider": "off",
        "@eslint-react/no-use-context": "off",
        "@stylistic/operator-linebreak": "off",
        "promise/always-return": "off",
        "typescript/consistent-type-imports": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-deprecated": "off",
        "typescript/no-misused-spread": "off",
        "typescript/non-nullable-type-assertion-style": "off",
        "typescript/prefer-optional-chain": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/switch-exhaustiveness-check": "off",
        "typescript/use-unknown-in-catch-callback-variable": "off",
        "unicorn/no-array-reverse": "off",
        "unicorn/no-array-sort": "off",
        "unicorn-js/no-break-in-nested-loop": "off",
        "unicorn-js/no-chained-comparison": "off",
        "unicorn-js/no-duplicate-if-branches": "off",
        "unicorn-js/no-late-event-control": "off",
        "unicorn-js/no-negated-comparison": "off",
        "unicorn-js/no-unsafe-string-replacement": "off",
        "unicorn-js/no-unnecessary-parameters": "off",
        "unicorn-js/no-unreadable-for-of-expression": "off",
        "unicorn-js/prefer-combined-guards": "off",
        "unicorn-js/prefer-continue": "off",
        "unicorn-js/prefer-includes-over-repeated-comparisons": "off",
        "unicorn-js/prefer-iterator-helpers": "off",
        "unicorn-js/prefer-iterator-to-array": "off",
        "unicorn-js/prefer-minimal-ternary": "off",
        "unicorn-js/prefer-number-is-safe-integer": "off",
        "unicorn-js/prefer-promise-with-resolvers": "off",
        "unicorn-js/prefer-set-methods": "off",
        "unicorn-js/prefer-short-escape-sequences": "off",
        "unicorn-js/prefer-simplified-conditions": "off",
        "unicorn-js/prefer-then-catch": "off",
        "unicorn-js/prefer-unicode-code-point-escapes": "off",
        "vitest/expect-expect": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/no-identical-title": "off",
        "vitest/prefer-strict-equal": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/valid-expect": "off"
      }
    }
  ]
}
