# Fork-only: normalize source text to LF so linting (and diff review) sees the
# same bytes on Windows checkouts regardless of the machine's core.autocrlf setting.
# Scoped to source extensions on purpose: test fixtures (srt/edl/xml/...) and other
# data files keep their committed line endings because snapshot tests read them
# byte-for-byte.
*.cjs text eol=lf
*.cts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.scss text eol=lf
*.sh text eol=lf
*.snap text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
